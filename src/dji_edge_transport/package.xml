<?xml version="1.0"?>
<package format="3">
  <name>dji_edge_transport</name>
  <version>0.1.0</version>
  <description>Primary-only C++ UDP/RTP transport for ROS 2 Humble.</description>
  <maintainer email="maintainers@example.invalid">DJI Transport Edge</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <build_depend>nlohmann-json3-dev</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
