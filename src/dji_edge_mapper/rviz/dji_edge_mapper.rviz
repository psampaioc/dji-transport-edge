Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map Cloud1
        - /Drone Path1
        - /Drone Pose1
        - /Frame-Synchronous Pose1
        - /Drone Camera1
      Splitter Ratio: 0.5
    Tree Height: 699
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
